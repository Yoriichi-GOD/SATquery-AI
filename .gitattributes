# Auto detect text files and perform LF normalization
* text=auto

# These source records are byte-hashed by the frozen evaluation manifest.
*.jsonl text eol=lf
/research/terrain_exposure/** text eol=lf
/research/vqa/** text eol=lf
/research/evaluation/** text eol=lf
/research/experiments/** text eol=lf
/research/cases/** text eol=lf
/research/registration/** text eol=lf
/research/datasets/** text eol=lf
/research/requirements-scientific*.txt text eol=lf
# Preserve exact bytes in the new content-addressed scientific receipts.
/research/results/terrain-exposure-20261105/** -text
/research/results/terrain-exposure-20261105/** whitespace=cr-at-eol
# Generated scientific vector artwork is reviewed as a rendered image, not path text.
/research/results/terrain-exposure-20261105/figures/*.svg -diff
# Pinned imported sources and content-addressed release receipts retain exact bytes.
/components/floodlab/** -text
/components/floodlab/** -whitespace
/components/FLOODLAB_SOURCE_MANIFEST.json -text
/research/results/case-campaign-20261107/** -text
/research/results/case-campaign-20261107/** whitespace=cr-at-eol
/research/results/case-campaign-20261107/figures/*.svg -diff
/research/results/validation-closure-20261107/** -text
/research/results/validation-closure-20261107/** whitespace=cr-at-eol
/research/results/vqa-finetuning-20261108/** -text
/research/results/vqa-finetuning-20261108/** whitespace=cr-at-eol
